# PostgreSQL Database connection string (e.g. Supabase, Neon, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/job_tracker?schema=public"

# Cryptographically strong secret key for signing JWT tokens (e.g. generate using: openssl rand -base64 32)
# Refuses to run in production if missing or set to a placeholder!
JWT_SECRET="your_secure_random_jwt_secret_here"

# Application Environment (development, production, test)
NODE_ENV="development"
